{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"module": "es2020",
		"rootDir": ".",
		"lib": ["es2020", "DOM"],
		"target": "es2019",
		"sourceMap": true
	},
	"include": [
		"src/**/*.d.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"./jest-setup.ts"
	]
}
